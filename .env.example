# API versions belong to request paths, for example v1/schedules/...
VITE_API_BASE_URL=/api
VITE_SCHEDULE_ID=00000000-0000-4000-8000-000000000001
FRONT_PORT=5173
STORYBOOK_PORT=6006
VITE_HMR_HOST=localhost
# VITE_STORYBOOK_URL=http://localhost:6006

# Native Vite defaults to http://127.0.0.1:8000.
# Docker Compose defaults to http://host.docker.internal:8000.
# Override only when the backend uses a different address or port:
# API_PROXY_TARGET=http://127.0.0.1:8000
